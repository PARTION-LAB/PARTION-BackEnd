<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.partion.comment.mapper.CommentMapper">

    <insert id="insert" parameterType="com.partion.comment.domain.Comment"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO comments (
        board_id,
        member_id,
        content
        )
        VALUES (
        #{boardId},
        #{memberId},
        #{content}
        )
    </insert>

</mapper>