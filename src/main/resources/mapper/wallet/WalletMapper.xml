<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.partion.wallet.mapper.WalletMapper">

    <insert id="insert" parameterType="com.partion.wallet.domain.Wallet"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO wallets (
        member_id,
        available_balance,
        locked_balance
        )
        VALUES (
        #{memberId},
        #{availableBalance},
        #{lockedBalance}
        )
    </insert>

</mapper>