<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.partion.board.mapper.BoardMapper">

    <insert id="insert" parameterType="com.partion.board.domain.Board"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO boards (
        member_id,
        category,
        title,
        content
        )
        VALUES (
        #{memberId},
        #{category},
        #{title},
        #{content}
        )
    </insert>

</mapper>